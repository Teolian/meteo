# Ice Fishing Bite Index API Configuration

# Timezone
TZ=Europe/Moscow

# MET Norway User-Agent (REQUIRED for MET Norway API)
# Format: AppName/Version (contact: email@example.com)
METNO_USER_AGENT=IceFishingApp/0.1 (contact: your-email@example.com)

# OpenWeather API Key (OPTIONAL - only if using OpenWeather provider)
# Get free key at: https://openweathermap.org/api
OPENWEATHER_KEY=

# Weather Provider Toggles
ENABLE_OPEN_METEO=true
ENABLE_METNO=true
ENABLE_OPENWEATHER=false

# Database
DATABASE_URL=sqlite:///./data/meteo.db

# Cache Settings
CACHE_TTL_MINUTES=60
CACHE_MAX_SIZE=128

# CORS Origins (comma-separated for production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Debug Mode
DEBUG=false
